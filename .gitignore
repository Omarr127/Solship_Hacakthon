# =========================
# Python core
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual environments
# =========================
venv/
env/
.venv/
ENV/

# =========================
# Jupyter Notebook
# =========================
.ipynb_checkpoints/

